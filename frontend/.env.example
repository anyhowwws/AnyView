# Base URL of the API. The browser calls Cloud Run directly (ADR 0006) — Firebase Hosting
# rewrites buffer responses and would break SSE streaming. Baked in at build time.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Firebase web config for sign-in (public, not secrets): `terraform output firebase_web_config`.
# Locally use the project's firebaseapp.com handler; production uses the custom domain.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=anyapps-anyview.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=anyapps-anyview
