# Local development only. Copy to .env (git-ignored) or export in your shell.
# There is no API key: model access uses Application Default Credentials
# (`gcloud auth application-default login`) and the project's IAM.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
VERTEX_REGION=global
MODEL_ID=gemini-3.1-pro-preview
# Streamed interviewer turns run here: latency over depth.
MODEL_ID_FAST=gemini-3.5-flash-lite
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000
# Comma-separated Google account emails allowed past sign-in. Empty = nobody.
ALLOWED_EMAILS=you@example.com
# Set to 1 to run with the scripted FakeModel instead of Vertex (no tokens spent).
ANYVIEW_FAKE_MODEL=0

# Database (ADR 0011). On Cloud Run: DB_INSTANCE + DB_IAM_USER (IAM auth, no password).
# On a laptop, either point at Cloud SQL the same way (your Google account as DB_IAM_USER)
# or at a local Postgres with DATABASE_URL. Tests use TEST_DATABASE_URL.
DB_INSTANCE=anyapps-anyview:us-central1:anyview-pg
DB_NAME=anyview
DB_IAM_USER=you@example.com
#DATABASE_URL=postgresql+psycopg://localhost/anyview
#TEST_DATABASE_URL=postgresql+psycopg://localhost/anyview_test
