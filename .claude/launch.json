{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api-fake",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "cd backend && ANYVIEW_FAKE_MODEL=1 .venv/bin/uvicorn anyview.main:app --port 8080"],
      "port": 8080
    },
    {
      "name": "api-vertex",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "cd backend && GOOGLE_CLOUD_PROJECT=anyapps-anyview .venv/bin/uvicorn anyview.main:app --port 8080"],
      "port": 8080
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "frontend"],
      "port": 3000
    }
  ]
}
